# Variáveis do ambiente LOCAL com Docker (docker-compose.yml).
# Copie para .env e troque os valores: o .env fica fora do Git (.gitignore)
# e fora da imagem (.dockerignore). Em produção (Render) as mesmas
# variáveis são preenchidas no painel - ver render.yaml e o README.

# Senha do PostgreSQL local do docker-compose (não é a do Supabase).
DB_PASSWORD=troque-esta-senha-local

# Assina os tokens de login. Gere uma por ambiente, ex.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_KEY=troque-por-64-caracteres-hexadecimais

# Origens do site que podem chamar a API (o "npm run dev" do site usa a 3000).
CORS_ORIGENS=http://localhost:3000,http://127.0.0.1:3000

# Endereço do site nos links dos e-mails (confirmar o e-mail, aprovar contas).
SITE_URL=http://localhost:3000

# Chave que cifra a biometria (vetores faciais e digitais) no banco:
# 64 caracteres hexadecimais. Sem ela, a biometria fica desligada (503).
# Gere uma por ambiente e NUNCA troque depois de cadastrar alunos: a
# biometria gravada com a chave antiga deixa de abrir. Ex.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BIOMETRIA_CHAVE=

# E-mails da equipe do sistema (tela /admin do site), separados por vírgula.
# Ela aprova as contas novas de escolas que ainda não usam o sistema.
ADMIN_EMAILS=

# Opcionais: sem eles, os avisos aos responsáveis ficam na fila de
# Notificações com um link wa.me (nenhuma mensagem é enviada sozinha).
# WhatsApp no formato da Meta Cloud API; WHATSAPP_TEMPLATE é o nome de um
# modelo aprovado com uma variável ({{1}}) para a mensagem.
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_TEMPLATE=
# E-mail por HTTP, no formato da API do Resend. Também leva o link de
# confirmação de quem se cadastra (sem ele, a equipe confirma em /admin).
EMAIL_API_URL=
EMAIL_API_TOKEN=
EMAIL_REMETENTE=
# Alternativa: mail() do PHP num servidor com sendmail.
SMTP_REMETENTE=
