# Variáveis do ambiente LOCAL com Docker (docker-compose.yml).
# Copie para .env e troque os valores: o .env fica fora do Git (.gitignore)
# e fora da imagem (.dockerignore). Em produção (Render) as mesmas
# variáveis são preenchidas no painel - ver render.yaml e o README.

# Senha do PostgreSQL local do docker-compose (não é a do Supabase).
DB_PASSWORD=troque-esta-senha-local

# Assina os tokens de login. Gere uma por ambiente, ex.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_KEY=troque-por-64-caracteres-hexadecimais

# Origens do site que podem chamar a API (o "npm run dev" do site usa a 3000).
CORS_ORIGENS=http://localhost:3000,http://127.0.0.1:3000

# Código pedido na tela "Cadastrar coordenação". Vazio = cadastro desligado.
CADASTRO_CODIGO_ACESSO=troque-este-codigo

# Chave que cifra a biometria (vetores faciais e digitais) no banco:
# 64 caracteres hexadecimais. Sem ela, a biometria fica desligada (503).
# Gere uma por ambiente e NUNCA troque depois de cadastrar alunos: a
# biometria gravada com a chave antiga deixa de abrir. Ex.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BIOMETRIA_CHAVE=

# Opcionais: sem eles, o contato do nível máximo de alerta fica na fila
# com um link wa.me (nenhuma mensagem é enviada sozinha).
SMTP_REMETENTE=
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
