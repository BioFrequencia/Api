# Apache (XAMPP e a imagem Docker desta API).
#
# Quando a URL está errada, o Apache devolve o 404 dele sozinho, sem
# passar pelo PHP - e sem cabeçalho de CORS o navegador reporta "blocked
# by CORS policy" em vez de "404". Foi isso que fez horas de depuração
# irem para o lugar errado.
#
# A correção NÃO é o Apache devolver o cabeçalho por conta própria: ele
# não conhece a allowlist, então refletiria qualquer origem e anularia a
# restrição feita em helpers/cors.php. Em vez disso, os erros são
# roteados para um PHP que aplica exatamente a mesma regra de CORS do
# resto da API - uma fonte de verdade só.
ErrorDocument 404 /erro.php
ErrorDocument 403 /erro.php
ErrorDocument 500 /erro.php

# O preflight (OPTIONS) NÃO pode ser respondido aqui. Existia uma regra
# "RewriteCond %{REQUEST_METHOD} OPTIONS / RewriteRule ... [R=204]" que
# devolvia 204 sem passar pelo PHP - logo, sem Access-Control-Allow-Origin
# - e o navegador bloqueava toda chamada do site depois que os cabeçalhos
# de CORS saíram deste arquivo. helpers/cors.php já responde o OPTIONS
# antes de abrir banco ou exigir token; erro.php faz o mesmo para URL
# inexistente.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Em PHP via CGI/FPM o Apache não repassa o cabeçalho Authorization
    # para o PHP; isto o devolve em HTTP_AUTHORIZATION (no mod_php, que é
    # o caso do XAMPP e do Docker, não muda nada).
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # OPTIONS para um arquivo que não existe: o Apache responderia ele
    # mesmo (200, sem CORS) e o navegador acusaria erro de CORS em vez do
    # 404. Vai para o erro.php, que responde o preflight com a allowlist;
    # a chamada seguinte recebe o 404 em JSON. (Confirmado no CI contra a
    # imagem Docker.)
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ erro.php [L]
</IfModule>

# Nunca servir configuração, dependências, testes ou histórico por HTTP.
<FilesMatch "^(config\.php|composer\.(json|lock)|\.env.*|Dockerfile|docker-entrypoint\.sh|.*\.sql|.*\.md)$">
    Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
RedirectMatch 404 /vendor/
RedirectMatch 404 /tests/
RedirectMatch 404 /database/migrations/
